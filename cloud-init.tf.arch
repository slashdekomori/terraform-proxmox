resource "proxmox_virtual_environment_file" "user_data_cloud_config" {
  content_type = "snippets"
  datastore_id = "local"
  node_name    = "psyche"

  source_raw {
    data = templatefile(
      "${path.module}/cloud-init/user-data.yaml.tftpl",
      {
        hostname = "vm-name"
        username = "dekomori"
        password = var.vm_password
        ssh_keys = var.ssh_keys
      }
    )

    file_name = "user-data.yaml"
  }
}

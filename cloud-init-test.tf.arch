resource "proxmox_virtual_environment_vm" "cloud-init-test" {
  name      = "cloud-init-test"
  node_name = "psyche"
  vm_id     = 8000

  cpu {
    cores   = 2
    sockets = 1
    type    = "host"
  }

  memory {
    dedicated = 1024
  }

  initialization {
    datastore_id = "slow"

    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }

    user_data_file_id = proxmox_virtual_environment_file.user_data_cloud_config.id
  }

  disk {
    datastore_id = "slow"
    import_from  = var.debian13-image
    interface    = "virtio0"
    iothread     = true
    backup       = false
    discard      = "on"
  }

  serial_device {
    device = "socket"
  }

  vga {
    type = "serial0"
  }

  operating_system {
    type = "l26"
  }

  machine = "q35"
  bios    = "ovmf"

  efi_disk {
    datastore_id = "slow"
    type         = "4m"
  }

  agent {
    enabled = true
    wait_for_ip {
      disabled = true
    }
  }

  network_device {
    bridge = "vmbr0"
    model  = "virtio"
  }

  template        = false
  started         = true
  stop_on_destroy = true
}

